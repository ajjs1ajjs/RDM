{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDM Manager",
  "version": "2.1.3",
  "identifier": "com.admin.rdm-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RDM Manager",
        "width": 1280,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.github.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": ["WebView2Loader.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "languages": ["English", "Ukrainian"],
        "minimumWebview2Version": "126.0.2592.68"
      },
      "wix": {
        "language": "en-US",
        "template": null
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-common"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "localhost",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "providerShortName": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ajjs1ajjs/RDM/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMDMyOEE2Mjc1MDQ1MjYKUldRbVJWQW5waWdEK3hkYUhCc1hqNG13MmN5TURBbTB4bDdHei8wWDFDL1lCMkpVVTZNMTNnbDcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
